{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git checkout:*)",
      "Bash(git switch:*)",
      "Bash(git log:*)",
      "Bash(python3 -m http.server:*)",
      "Bash(npx serve:*)",
      "Bash(npx wrangler pages:*)",
      "Bash(wrangler pages:*)"
    ],
    "deny": [
      "Bash(git push:* --force*)",
      "Bash(rm -rf:*)"
    ]
  },
  "//": "Plain static HTML - there is NO npm build. Preview locally with `python3 -m http.server 8080` (or `npx serve`). Deploy is automatic: Cloudflare Pages builds on push. `wrangler pages` is available for manual/preview deploys if ever needed."
}
